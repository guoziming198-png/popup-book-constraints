{
  "name": "popup-book-constraints",
  "version": "1.0.0",
  "private": true,
  "description": "1920x1080 60fps Remotion director's cut recreation: Popup Book - More Constraints Make Work Stand Out",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "build": "remotion render src/index.ts PopupBookConstraints out/popup-book-constraints.mp4 --codec=h264 --pixel-format=yuv420p --crf=18",
    "still": "remotion still src/index.ts PopupBookConstraints",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.234",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.234"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
